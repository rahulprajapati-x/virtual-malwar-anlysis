# ================================================================
#  CYBERFORGE FORENSICS PLATFORM — Environment Configuration
#  Copy this file to .env and fill in your values
# ================================================================

# ---- DATABASE ----
DATABASE_URL=postgresql://cyberforge:strongpassword@localhost:5432/cyberforge_db

# ---- REDIS (for Celery task queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- FILE STORAGE ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
YARA_RULES_DIR=./yara_rules

# ---- THREAT INTELLIGENCE APIs ----
# VirusTotal API v3 key — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_vt_api_key_here

# AbuseIPDB API key — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# MalwareBazaar (no key needed, but you can add for premium)
MALWAREBAZAAR_API_KEY=

# AlienVault OTX API key
OTX_API_KEY=your_otx_key_here

# ---- SANDBOXING ----
# Any.run API key (optional, for cloud sandbox)
ANYRUN_API_KEY=

# ---- JWT AUTH (for production) ----
SECRET_KEY=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- APP CONFIG ----
APP_NAME=CyberForge Forensics Platform
APP_VERSION=2.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
